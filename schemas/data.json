{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chirag127.github.io/india-public-holidays/schemas/data.json",
  "title": "India Public Holidays",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "country",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z0-9-]+$"
      },
      "name": {
        "type": "string"
      },
      "country": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    }
  }
}
